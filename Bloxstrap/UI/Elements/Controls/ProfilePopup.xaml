<UserControl x:Class="Bloxstrap.UI.Elements.Controls.ProfilePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             mc:Ignorable="d"
             d:DesignWidth="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

        <Border x:Name="PopupRoot"
            Margin="8"
            MinWidth="320"
            MaxWidth="360"
            Padding="16"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            Background="{DynamicResource ProfilePopupBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.55" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="48" Height="48">
                    <Ellipse Fill="{DynamicResource GoldHoverBrush}"
                             Stroke="{DynamicResource GoldPrimaryBrush}"
                             StrokeThickness="1" />

                    <Grid>
                        <Grid.Clip>
                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                        </Grid.Clip>

                        <ui:SymbolIcon Symbol="Person24"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GoldPrimaryBrush}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <Image Source="{Binding AvatarSource}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAvatar}" Value="True" />
                                                <Condition Binding="{Binding IsAvatarAnimated}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Image gif:AnimationBehavior.SourceUri="{Binding AvatarUri}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvatarAnimated}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelcomeText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{Binding UsernameFont}" />

                    <Image Width="18" Height="18"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/Resources/verified.png"
                           Visibility="{Binding IsVerified, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </Grid>

            <controls:OptionControl Header="{x:Static resources:Strings.Profile_Avatar_Title}"
                                    Description="{x:Static resources:Strings.Profile_Avatar_Description}">
                <ui:Button Content="{x:Static resources:Strings.Profile_Avatar_Choose}"
                           Command="{Binding ChooseAvatarCommand, Mode=OneTime}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Profile_Username_Title}"
                                    Description="{x:Static resources:Strings.Profile_Username_Description}">
                <ui:TextBox Width="160"
                            MaxLength="20"
                            PlaceholderText="{x:Static resources:Strings.Profile_Username_Placeholder}"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            LostFocus="UsernameBox_LostFocus"
                            KeyDown="UsernameBox_KeyDown" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Profile_Verified_Title}"
                                    Description="{x:Static resources:Strings.Profile_Verified_Description}">
                <ui:ToggleSwitch IsChecked="{Binding IsVerified, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Profile_Font_Title}"
                                    Description="{x:Static resources:Strings.Profile_Font_Description}">
                <ComboBox Width="160"
                          ItemsSource="{Binding Fonts, Mode=OneTime}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedFont, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="{x:Static resources:Strings.Profile_Streak_Title}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           gif:AnimationBehavior.SourceUri="/Resources/StreakGIF.gif" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding StreakText}" />
                </StackPanel>
            </controls:OptionControl>
        </StackPanel>
    </Border>
</UserControl>
